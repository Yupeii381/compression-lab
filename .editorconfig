root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true

[*.{csproj,props,pubxml,json}]
indent_style = space
indent_size = 2

# Preserve upstream SDK sources verbatim.
[src/CompressionLab.Codecs.Lzma/Vendor/**]
generated_code = true
